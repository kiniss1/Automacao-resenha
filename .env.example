# Nome exato do grupo WhatsApp a monitorar (resenha de atividades)
GRUPO_NOME=OOMC - Retorno de atividades

# Nome exato do grupo WhatsApp para relatório de inspeções
GRUPO_INSP_NOME=OPERAÇÃO OMA

# Nome exato do grupo WhatsApp para notificações de check-in
GRUPO_CHECKIN_NOME=OPERAÇÃO OMA

# Nome exato do grupo WhatsApp para notificação de autoinspeção registrada
GRUPO_RETORNO_NOME=OOMC (Resenha, APR e APRD)

# IDs fixos de grupo (recomendado em produção — mais confiável que o nome).
# Formato do ID: 120363xxxxxxxxxxxx@g.us (aparece no log do bot quando ele
# auto-cacheia o grupo pela primeira mensagem recebida).
# Aceita mais de um grupo separando por vírgula, pra enviar a mesma mensagem
# em todos: GRUPO_RELATORIO_ID=120363111...@g.us,120363222...@g.us
# GRUPO_RELATORIO_ID=
# GRUPO_RETORNO_ID=

# Porta do servidor web (Railway define automaticamente)
PORT=3000

# Caminho do banco de dados (use /data para persistir no volume Railway)
DB_PATH=/data/os.db

# Caminho da sessão WhatsApp
WA_DATA_PATH=/data/.wwebjs_auth

# Executável do Chromium (já definido no Dockerfile)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
