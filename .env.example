# Nome exato do grupo WhatsApp a monitorar
GRUPO_NOME=Resenha

# Porta do servidor web (Railway define automaticamente)
PORT=3000

# Caminho do banco de dados (use /data para persistir no volume Railway)
DB_PATH=/data/os.db

# Caminho da sessão WhatsApp
WA_DATA_PATH=/data/.wwebjs_auth

# Executável do Chromium (já definido no Dockerfile)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
